float2 p=UV*2-1;
float2 q=abs(p)-float2(.80,.84);
float sd=length(max(q,0))+min(max(q.x,q.y),0)-.16;
float mask=1-smoothstep(-.004,.004,sd);
float t=Clock*ScrollSpeed;
float burst=step(.975,frac(sin(floor(Clock*.35)*91.7)*43758.54));
float row=floor(UV.y*90);
float jitter=(frac(sin(row*12.9898+floor(Clock*8))*43758.54)-.5);
p.x+=DistortionStrength*jitter*(.12+burst);
// Rectangular perspective tunnel, with four walls converging into a dark center.
float r=max(abs(p.x),abs(p.y));
float depth=min(18.,1./max(r,.05)-1.);
float along=abs(p.x)>abs(p.y)?p.y/max(abs(p.x),.05):p.x/max(abs(p.y),.05);
float2 g=float2(along*GridDensity*.5,depth*GridDensity*.3-t);
float2 edge=abs(frac(g+.5)-.5);
float2 aa=max(fwidth(g),.008);
float2 lines=1-smoothstep(float2(.009,.009),float2(.009,.009)+aa,edge);
float fade=smoothstep(.11,.50,r)*exp(-depth*.23);
float grid=max(lines.x,lines.y)*GridBrightness*fade;
float2 cell=floor(g);
float hash=frac(sin(dot(cell,float2(127.1,311.7)))*43758.5453);
float2 local=abs(frac(g)-.5);
float square=(1-smoothstep(.10,.17,max(local.x,local.y)))*step(.973,hash);
float packets=square*DataBrightness*fade*(.65+.35*sin(Clock+hash*50));
float noise=frac(sin(dot(floor(UV*float2(230,320)),float2(12.9898,78.233))+floor(Clock*5))*43758.54);
float scan=(.5+.5*sin(UV.y*650-Clock*.55))*NoiseStrength*.018;
float rim=exp(-abs(sd+.015)*155)*RimBrightness;
float ambient=(1-saturate(CenterBlackness))*.014*(.15+.85*r*r);
float light=grid+packets+rim+noise*NoiseStrength*.012*fade+scan*fade;
light+=burst*NoiseStrength*.07*step(.985,noise)*fade;
float3 col=float3(.001,.003,.008)*ambient+PortalColor*(light*EmissiveStrength);
return float4(col,mask);
