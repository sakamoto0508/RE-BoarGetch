// Action Camera Framework - Screen / Level Transitions (Phase 7D, README 33 章).
//
// The body of the Custom node of /ActionCameraFramework/Transitions/M_ACFTransition (UI domain, translucent).
// Scripts/Transitions/CreateTransitionAssets.py copies this file into the node; edit it here and re-run the script.
// The cooked material does not read this file.
//
// Inputs of the Custom node (names must match):
//   UV (float2, widget UV 0..1), Effect (1..42), T (coverage 0 = scene visible .. 1 = fully covered, already eased),
//   Opening (0 close / 1 open), Intensity, Direction (degrees), Seed, Aspect (width / height), Time (seconds since the
//   transition started), Softness, Count, Reverse (+1 / -1), Origin (0 screen edge / 1 Center), SnapEnc (1 = SnapTex holds sRGB-encoded values), Col, Col2 (float3), Center (float2, UV), UseSnap, UseOver,
//   SnapTex / OverTex (Texture2D objects; SnapTexSampler / OverTexSampler are generated by the material compiler).
// Output: float4 (rgb, coverage alpha). T <= 0 is always fully transparent and T >= 1 always fully opaque.

struct FACFTransition
{
	float2 uv; float2 q; float aspect; float t; float op; float inten; float dirRad; float seed; float time;
	float soft; float cnt; float rev; float3 c1; float3 c2; float2 ctr; float useSnap; float useOver; float px; float origin; float snapEnc;

	// ---------------------------------------------------------------- helpers
	float H21(float2 p) { p = frac(p * float2(123.34, 456.21) + seed * 0.1371); p += dot(p, p + 45.32); return frac(p.x * p.y); }
	float H11(float x) { return frac(sin(x * 127.1 + seed * 3.17) * 43758.5453); }
	float VNoise(float2 p)
	{
		float2 i = floor(p); float2 f = frac(p); float2 u = f * f * (3.0 - 2.0 * f);
		return lerp(lerp(H21(i), H21(i + float2(1, 0)), u.x), lerp(H21(i + float2(0, 1)), H21(i + float2(1, 1)), u.x), u.y);
	}
	float Fbm(float2 p)
	{
		float s = 0.0; float a = 0.5;
		for (int i = 0; i < 5; ++i) { s += a * VNoise(p); p = p * 2.03 + 17.1; a *= 0.5; }
		return s;
	}
	// Coverage of a signed distance (negative = inside) with one pixel of anti-aliasing.
	float Fill(float d) { return saturate(0.5 - d / px); }
	float FillSoft(float d, float w) { return saturate(0.5 - d / max(px, w)); }
	float2 Rot(float2 p, float a) { float s = sin(a); float c = cos(a); return float2(c * p.x - s * p.y, s * p.x + c * p.y); }
	float2 CenterQ() { return (ctr - 0.5) * float2(aspect, 1.0); }
	// Distance from a point to the farthest screen corner (the radius that covers the whole screen).
	float MaxR(float2 c)
	{
		float2 h = float2(aspect * 0.5, 0.5);
		return length(max(abs(c - float2(-h.x, -h.y)), abs(c - float2(h.x, h.y))));
	}
	// 0..1 position along a direction (angle in radians), 0 where the direction starts.
	float Along(float2 p, float a)
	{
		float2 d = float2(cos(a), sin(a));
		float e = 0.5 * (aspect * abs(d.x) + abs(d.y));
		return (dot(p, d) + e) / (2.0 * e);
	}
	float EaseOutBack(float x) { x = saturate(x); float c = 1.70158; float y = x - 1.0; return 1.0 + (c + 1.0) * y * y * y + c * y * y; }
	float EaseOutBounce(float x)
	{
		x = saturate(x);
		if (x < 1.0 / 2.75) return 7.5625 * x * x;
		if (x < 2.0 / 2.75) { x -= 1.5 / 2.75; return 7.5625 * x * x + 0.75; }
		if (x < 2.5 / 2.75) { x -= 2.25 / 2.75; return 7.5625 * x * x + 0.9375; }
		x -= 2.625 / 2.75; return 7.5625 * x * x + 0.984375;
	}
	float Luma(float3 c) { return dot(c, float3(0.299, 0.587, 0.114)); }
	float SdBox(float2 p, float2 b) { float2 d = abs(p) - b; return length(max(d, 0.0)) + min(max(d.x, d.y), 0.0); }
	float SdSegment(float2 p, float2 a, float2 b) { float2 pa = p - a; float2 ba = b - a; float h = saturate(dot(pa, ba) / dot(ba, ba)); return length(pa - ba * h); }
	float2 QToUV(float2 p) { return p / float2(aspect, 1.0) + 0.5; }

	// SnapEnc 1: the capture holds the back buffer's sRGB-encoded values in a UNORM texture (the 10-bit GPU copy), decoded
	// here; 0: the texture is sRGB and the sampler already returns linear colours.
	float3 Snap(Texture2D tx, SamplerState ss, float2 u)
	{
		float3 c = Texture2DSampleLevel(tx, ss, saturate(u), 0).rgb;
		if (snapEnc > 0.5) c = c <= 0.04045 ? c / 12.92 : pow((max(c, 0.04045) + 0.055) / 1.055, 2.4);
		return c;
	}
	float4 Over(Texture2D tx, SamplerState ss, float2 u) { return Texture2DSampleLevel(tx, ss, u, 0); }
	bool SnapOn() { return useSnap > 0.5; }

	// ---------------------------------------------------------------- 01 .. 16 basic / wipe / digital
	float4 E01() { return float4(c1, t); }
	float4 E02()
	{
		float r = length(q - CenterQ());
		float glare = (1.0 - smoothstep(0.0, 0.9, r)) * t * 0.9;
		float a = saturate(pow(t, 0.85) + glare * 0.7);
		float3 col = c1 + c2 * glare * 1.5;
		return float4(col, a);
	}
	float4 E03() { return float4(lerp(c1, c2, uv.y), t); }
	float4 E04(Texture2D sx, SamplerState ss)
	{
		if (SnapOn()) return float4(Snap(sx, ss, uv), t);
		float n = VNoise(q * 9.0) * 0.7 + VNoise(q * 31.0) * 0.3;
		return float4(c1, smoothstep(n - 0.08, n + 0.08, t * 1.2 - 0.1));
	}
	float4 Wipe(float angle, float feather)
	{
		float n = Along(q, angle);
		float m = op > 0.5 ? 1.0 - n : n;
		float w = max(feather, 0.0001);
		float e = t * (1.0 + 2.0 * w) - w;
		float a = saturate((e - m) / w + 0.5 * px / w);
		a = max(a, Fill(m - e)) * step(0.0, e + w);
		float glow = exp(-abs(m - e) / 0.006) * step(0.0001, t) * step(t, 0.9999);
		return float4(lerp(c1, c2, glow), saturate(a + glow * 0.9));
	}
	float4 E05() { return Wipe(dirRad, 0.002 + soft * 0.05); }
	float4 E06() { return Wipe(dirRad, 0.02 + soft * 0.15); }
	float4 E07()
	{
		float2 c = CenterQ();
		float R = MaxR(c) * (1.0 - t);
		return float4(c1, Fill(R - length(q - c)));
	}
	float4 E08()
	{
		// 6-blade camera diaphragm: a rotating regular polygon with the blade seams drawn on the closed area.
		float n = max(3.0, round(cnt));
		float2 p = q - CenterQ();
		float R = MaxR(CenterQ()) * 1.25 * (1.0 - t);
		float rotA = rev * t * 1.7;
		float2 pr = Rot(p, rotA);
		float an = atan2(pr.y, pr.x);
		float sector = 6.2831853 / n;
		float k = floor(an / sector + 0.5);
		float2 axis = float2(cos(k * sector), sin(k * sector));
		float apothem = R * cos(3.14159265 / n);
		float d = dot(pr, axis) - apothem; // polygon SDF (inside negative)
		float cov = Fill(-d);
		// Seams: each edge line extended outward; the side of the blade beyond its edge shows a seam line.
		float seam = 1.0;
		for (int i = 0; i < 12; ++i)
		{
			if (i >= (int)n) break;
			float ai = i * sector;
			float2 ax = float2(cos(ai), sin(ai));
			float2 tg = float2(-ax.y, ax.x);
			float2 v = ax * apothem + tg * R * sin(3.14159265 / n);
			float dl = abs(dot(pr - v, ax));
			float along = dot(pr - v, tg);
			if (along > 0.0) seam = min(seam, dl);
		}
		float ln = (1.0 - smoothstep(px, px * 2.5, seam)) * cov;
		float shade = 0.75 + 0.25 * cos(an * n);
		float3 col = c1 * shade + c2 * ln;
		return float4(col, cov);
	}
	float4 E09()
	{
		float n = max(2.0, round(cnt));
		float i = floor(uv.x * n);
		float f = frac(uv.x * n);
		float order = rev > 0.0 ? i / (n - 1.0) : 1.0 - i / (n - 1.0);
		float st = 0.4;
		float lt = saturate(t * (1.0 + st) - st * order);
		float d = abs(f - 0.5) * 2.0 - lt; // slat widens from its centre
		float a = Fill(d / n * aspect) * step(0.0001, lt);
		float shade = 0.55 + 0.45 * cos((f - 0.5) * 3.14159 * (1.0 - lt * 0.7));
		return float4(c1 * shade + c2 * 0.15 * (1.0 - shade), a);
	}
	float4 E10()
	{
		float e = (op > 0.5 ? t : EaseOutBounce(t)) * 0.5;
		float top = uv.y - e;
		float bot = (1.0 - uv.y) - e;
		float a = max(Fill(top), Fill(bot));
		float slat = step(0.82, frac((top < 0.0 ? uv.y - e : uv.y + e) * 22.0));
		float seam = exp(-min(abs(top), abs(bot)) / 0.004);
		float3 col = c1 * (0.85 + 0.15 * (1.0 - slat)) * (0.8 + 0.2 * sin(uv.x * 3.14159)) + c2 * seam * 0.6;
		return float4(col, a);
	}
	float4 E11()
	{
		float L = max(8.0, round(cnt));
		float i = floor(uv.y * L);
		float f = frac(uv.y * L);
		float delay = fmod(i, 2.0) * 0.45 + H11(i) * 0.2;
		float lt = saturate((t - delay * 0.75) / 0.35);
		float a = step(f, lt) * step(0.0001, lt);
		float flick = H21(float2(i, floor(time * 30.0)));
		return float4(c1 + c2 * 0.25 * flick, a);
	}
	float4 E12(Texture2D sx, SamplerState ss)
	{
		float tq = floor(time * 18.0);
		float band = floor(uv.y * 24.0 + H11(tq) * 7.0);
		float bh = H21(float2(band, tq));
		float inBand = step(bh, t * 1.4 * inten);
		float shift = (H21(float2(band + 3.0, tq)) - 0.5) * 0.18 * t * inten;
		float2 cell = floor(uv * float2(10.0, 7.0) * (1.0 + floor(H11(tq + 2.0) * 3.0)));
		float block = step(H21(cell + tq * 0.37), pow(t, 1.6));
		float3 col;
		if (SnapOn())
		{
			float ca = 0.012 * inten;
			col = float3(Snap(sx, ss, uv + float2(shift + ca, 0)).r, Snap(sx, ss, uv + float2(shift, 0)).g, Snap(sx, ss, uv + float2(shift - ca, 0)).b);
		}
		else
		{
			float s = H21(float2(floor(uv.x * 60.0 + shift * 200.0), band));
			col = lerp(c2, float3(0.1, 0.9, 1.0), step(0.5, s)) * (0.4 + 0.6 * s);
		}
		col = lerp(col, c1, block);
		return float4(col, max(inBand, block));
	}
	float4 E13()
	{
		float cells = max(8.0, round(cnt));
		float s = 1.0 / cells;
		float2 cell = floor(q / s);
		float2 f = frac(q / s);
		float2 cq = (cell + 0.5) * s;
		float thr = 0.65 * H21(cell) + 0.35 * Along(cq, dirRad);
		float lt = saturate((t * 1.08 - thr * 0.92) / 0.08);
		float sz = lt;
		float d = max(abs(f.x - 0.5), abs(f.y - 0.5)) * 2.0 - sz;
		float a = Fill(d * s * 0.5) * step(0.0001, lt);
		float spark = (1.0 - lt) * step(0.0001, lt) * 2.0;
		return float4(lerp(c1, c2, saturate(spark)), saturate(a + step(0.0001, lt) * (1.0 - lt) * 0.0));
	}
	float4 E14(Texture2D sx, SamplerState ss)
	{
		if (SnapOn() && op < 0.5)
		{
			float b = lerp(px, 1.0 / 10.0, smoothstep(0.0, 0.75, t));
			float2 qq = (floor(q / b) + 0.5) * b;
			float3 col = Snap(sx, ss, QToUV(qq));
			col = lerp(col, c1, smoothstep(0.72, 1.0, t));
			return float4(col, saturate(t * 40.0));
		}
		float cells = lerp(48.0, 6.0, t);
		float b2 = 1.0 / cells;
		float2 cell = floor(q / b2);
		float h = H21(cell + floor(cells));
		float a = step(h, t);
		return float4(lerp(c1, c2, h * 0.35), a);
	}
	float4 E15(Texture2D sx, SamplerState ss)
	{
		float2 c = CenterQ();
		float2 p = q - c;
		float r = length(p);
		float ang = atan2(p.y, p.x);
		float spoke = step(0.9, H11(floor(ang * 70.0 / 6.2831853 * 6.0) + floor(time * 20.0)));
		float lines = spoke * smoothstep(0.08, 0.5, r) * t;
		if (SnapOn() && op < 0.5)
		{
			float sc = 1.0 + t * t * 2.5 * inten;
			float3 acc = 0;
			for (int k = 0; k < 8; ++k)
			{
				float s2 = sc * (1.0 + k * 0.035 * t);
				acc += Snap(sx, ss, QToUV(c + p / s2));
			}
			float3 col = acc / 8.0 + c2 * lines;
			col = lerp(col, c1, smoothstep(0.7, 1.0, t));
			return float4(col, saturate(t * 40.0));
		}
		float R = MaxR(c) * (1.0 - t) * (0.82 + 0.36 * H11(floor(ang * 40.0)));
		float a = Fill(R - r);
		return float4(lerp(c1, c2, lines), saturate(a + lines));
	}
	float4 E16(Texture2D sx, SamplerState ss)
	{
		float2 c = CenterQ();
		float2 p = q - c;
		float r = length(p);
		float mr = MaxR(c);
		if (SnapOn() && op < 0.5)
		{
			float tw = rev * t * t * 7.0 * inten * (1.0 - saturate(r / mr));
			float2 pp = Rot(p, tw) * (1.0 + t * 1.8);
			float2 u = QToUV(c + pp);
			float inside = step(0.0, u.x) * step(u.x, 1.0) * step(0.0, u.y) * step(u.y, 1.0);
			float3 col = lerp(c1, Snap(sx, ss, u), inside);
			col = lerp(col, c1, smoothstep(0.65, 1.0, t));
			return float4(col, saturate(t * 40.0));
		}
		float ang = atan2(p.y, p.x) * rev + t * 5.0 + r * 4.0;
		float arms = max(2.0, round(cnt));
		float f = frac(ang / 6.2831853 * arms);
		float a = step(f, t) * step(0.0001, t);
		return float4(c1, a);
	}

	// ---------------------------------------------------------------- 17 .. 24 special
	float4 E17()
	{
		float2 c = CenterQ();
		float2 p = q - c;
		float r = length(p);
		float ang = atan2(p.y, p.x);
		float mr = MaxR(c) * 1.12;
		float R = op > 0.5 ? mr * (1.0 - t) : mr * t;
		float Rw = R * (1.0 + 0.07 * (VNoise(float2(ang * 3.0, time * 2.0)) - 0.5) * 2.0);
		float inside = op > 0.5 ? Fill(Rw - r) : Fill(r - Rw); // opening: the scene is inside the ring
		float cov = op > 0.5 ? 1.0 - inside : 1.0 - inside;
		cov = op > 0.5 ? Fill(r - Rw) : Fill(Rw - r);
		float swirl = 0.5 + 0.5 * sin(ang * 5.0 + r * 30.0 - time * 8.0);
		float rim = exp(-abs(r - Rw) / 0.012) * step(0.0001, t) * step(t, 0.9999);
		float3 col = c1 + c2 * swirl * 0.25 + c2 * rim * 2.0;
		return float4(col, saturate(cov + rim));
	}
	float4 E18()
	{
		float sc = max(3.0, cnt);
		float2 p = q * sc;
		float2 ip = floor(p);
		float d1 = 8.0; float d2 = 8.0; float2 id = 0;
		for (int y = -1; y <= 1; ++y)
		for (int x = -1; x <= 1; ++x)
		{
			float2 g = ip + float2(x, y);
			float2 o = float2(H21(g), H21(g + 31.7));
			float d = length(g + o - p);
			if (d < d1) { d2 = d1; d1 = d; id = g; }
			else if (d < d2) { d2 = d; }
		}
		float thr = 0.7 * H21(id + 5.0) + 0.3 * Along(id / sc, dirRad);
		float lt = saturate((t * 1.1 - thr * 0.9) / 0.2);
		float a = Fill((d1 - lt * 1.6) / sc) * step(0.0001, lt);
		float edge = exp(-(d2 - d1) * 14.0) * step(0.0001, lt) * (1.0 - lt);
		return float4(lerp(c1, c2, saturate(edge * 2.0)), saturate(a + edge));
	}
	float4 E19()
	{
		float mr = MaxR(float2(0, 0));
		float d = 9.0;
		for (int i = 0; i < 7; ++i)
		{
			float fi = i;
			float2 cpos = (float2(H11(fi + 1.3), H11(fi + 7.9)) - 0.5) * float2(aspect, 1.0) * 0.9;
			float delay = H11(fi + 3.3) * 0.35;
			float g = pow(saturate((t - delay) / (1.0 - delay)), 1.6);
			float R = g * mr * 1.15;
			float2 dp = q - cpos;
			float wob = (Fbm(dp * 5.0 + fi * 13.0) - 0.5) * 0.5 * R;
			d = min(d, length(dp) - R - wob);
			// splatter drops
			float2 sp = cpos + (float2(H11(fi + 11.0), H11(fi + 17.0)) - 0.5) * 0.3;
			d = min(d, length(q - sp) - g * 0.05);
		}
		return float4(c1 + c2 * 0.08 * VNoise(q * 40.0), Fill(d));
	}
	float4 E20(Texture2D sx, SamplerState ss)
	{
		float n = max(2.0, round(cnt));
		float i = floor(uv.y * n);
		float sgn = fmod(i, 2.0) < 0.5 ? rev : -rev;
		float delay = H11(i) * 0.25;
		float lt = saturate((t - delay) / 0.75);
		lt = lt * lt * (3.0 - 2.0 * lt);
		float cover = sgn > 0.0 ? lt - uv.x : uv.x - (1.0 - lt);
		float a = Fill(-cover * aspect);
		float edgeY = min(frac(uv.y * n), 1.0 - frac(uv.y * n)) / n;
		float hl = (1.0 - smoothstep(px, px * 3.0, edgeY)) * step(0.0001, lt);
		if (SnapOn() && op < 0.5)
		{
			float3 col = lerp(Snap(sx, ss, uv - float2(sgn * lt, 0.0)), c1, a);
			return float4(col + c2 * hl * 0.5, saturate(t * 40.0));
		}
		return float4(c1 + c2 * hl * 0.5, saturate(a + hl * step(0.0001, lt) * 0.5));
	}
	float4 E21()
	{
		float n = Along(q, dirRad);
		float m = op > 0.5 ? 1.0 - n : n;
		float e = t * 1.5 - 0.25;
		float g = exp(-abs(m - e) / 0.03) * 1.3 + exp(-abs(m - e) / 0.14) * 0.5;
		g *= step(0.0001, t) * step(t, 0.9999);
		float behind = saturate((e - m) / 0.25 + 0.5) * step(0.0, e - m + 0.12);
		behind = saturate((e - m) / 0.12);
		float3 col = c1 + c2 * g;
		return float4(col, saturate(behind + g * 0.85));
	}
	float4 E22()
	{
		float b = Fbm(q * 3.0 + seed) * 0.62 + 0.38 * Along(q, dirRad);
		float th = t * 1.3 - 0.12;
		float d = b - th;
		float burnt = Fill(d * 0.2);
		float edge = 1.0 - smoothstep(0.0, 0.07, d);
		edge *= step(0.0, d) * step(0.0001, t);
		float3 hot = lerp(c2, float3(1.0, 0.95, 0.6), saturate(1.0 - d / 0.025));
		float3 col = lerp(c1, hot, edge);
		float tint = 0.12 * t * (1.0 - burnt);
		return float4(lerp(col, c2, tint * (1.0 - edge)), saturate(burnt + edge + tint));
	}
	float4 E23(Texture2D sx, SamplerState ss)
	{
		if (SnapOn() && op < 0.5)
		{
			float k = t * t * 0.09 * inten;
			float2 w = float2(sin(uv.y * 22.0 + time * 7.0) + sin(uv.y * 9.0 - time * 3.0), cos(uv.x * 17.0 + time * 6.0)) * k;
			float2 p = q - CenterQ();
			w += Rot(p, t * 1.2 * rev) - p;
			float ca = 0.02 * t * inten;
			float2 u = uv + w;
			float3 col = float3(Snap(sx, ss, u + ca).r, Snap(sx, ss, u).g, Snap(sx, ss, u - ca).b);
			col = lerp(col, c1, smoothstep(0.7, 1.0, t));
			return float4(col, saturate(t * 40.0));
		}
		float2 warp = float2(Fbm(q * 2.0 + time * 0.3), Fbm(q * 2.0 + 9.0 - time * 0.3));
		float f = Fbm(q * 3.0 + warp * 2.0);
		float d = f - (t * 1.25 - 0.12);
		float a = Fill(d * 0.15);
		float eR = exp(-abs(d - 0.012) / 0.006); float eB = exp(-abs(d + 0.012) / 0.006);
		float3 col = c1 + float3(eR, 0.2 * (eR + eB), eB) * c2 * 1.5;
		return float4(col, saturate(a + (eR + eB) * 0.7 * step(0.0001, t)));
	}
	float4 E24()
	{
		float cover; float y;
		if (op < 0.5) { y = uv.y - (1.0 - t * 1.08) - (uv.x - 0.5) * 0.06; cover = Fill(-y * 1.0); }
		else { y = (t * 1.08) - uv.y + (uv.x - 0.5) * 0.06; cover = Fill(-y); }
		float stripes = step(0.5, frac((q.x + q.y) * 18.0)) * step(0.82, uv.y) * step(uv.y, 0.9);
		float2 sp = q - float2(aspect * 0.5 - 0.12, 0.37);
		float ring = abs(length(sp) - 0.04) - 0.006;
		float arcA = frac(atan2(sp.y, sp.x) / 6.2831853 - time * 1.2);
		float spin = Fill(ring) * step(arcA, 0.7) * smoothstep(0.75, 1.0, t);
		float3 col = c1 + c2 * stripes * 0.18 + c2 * spin;
		return float4(col, cover);
	}

	// ---------------------------------------------------------------- 25 .. 40 game / special
	float NetLines(float2 p, float scale)
	{
		float2 g = Rot(p, 0.785398) * scale;
		float2 f = frac(g);
		float d = min(min(f.x, 1.0 - f.x), min(f.y, 1.0 - f.y)) / scale;
		float2 k = abs(f - 0.5);
		float knot = length(max(abs(f - round(f)), 0.0));
		return min(d, knot / scale);
	}
	float4 E25(Texture2D ox, SamplerState os)
	{
		float n = Along(q, dirRad) + 0.06 * sin(uv.x * 3.14159 + uv.y * 2.0);
		float m = op > 0.5 ? 1.0 - n : n;
		float e = t * 1.45 - 0.2;
		float area = Fill(m - e);
		float lineD = NetLines(q + float2(0.0, -e * 0.15), 16.0 * inten);
		float rope = 1.0 - smoothstep(px * 0.8, px * 2.2, lineD);
		if (useOver > 0.5) rope = Over(ox, os, q * 4.0).a;
		float border = exp(-abs(m - e) / 0.008);
		float dark = saturate((e - m) / 0.4 + pow(t, 6.0));
		float a = saturate(area * max(rope, dark) + border * step(0.0001, t) * step(t, 0.9999));
		float3 col = lerp(c1, c2, saturate(rope * (1.0 - pow(t, 4.0)) + border));
		return float4(col, a);
	}
	float4 E26(Texture2D ox, SamplerState os)
	{
		float drop = saturate(t / 0.55);
		float yb = op > 0.5 ? drop : EaseOutBounce(drop);
		float n = max(3.0, round(cnt));
		float fx = frac(uv.x * n);
		float barW = 0.22;
		float bx = abs(fx - 0.5) / barW;
		float bar = step(bx, 1.0) * step(uv.y, yb);
		float crossb = (step(abs(uv.y - (yb - 0.04)), 0.018) + step(abs(uv.y - (yb - 0.42)), 0.012)) * step(uv.y, yb);
		float shade = sqrt(saturate(1.0 - bx * bx));
		if (useOver > 0.5) { float4 o = Over(ox, os, float2(fx, uv.y - yb)); bar = o.a * step(uv.y, yb); shade = 1.0; }
		float metal = saturate(bar + crossb);
		float dark = saturate((t - 0.5) / 0.45);
		float3 col = lerp(c1, c2 * (0.35 + 0.65 * shade) + 0.25 * pow(shade, 8.0), metal);
		return float4(col, saturate(metal + dark));
	}
	float4 E27()
	{
		float cx = (ctr.x - 0.5) * aspect;
		float w = pow(t, 1.4) * aspect * 0.62 + 0.015 * step(0.0001, t);
		float dx = abs(q.x - cx);
		float body = 1.0 - smoothstep(w * 0.7, w, dx);
		float rings = 0.5 + 0.5 * sin(q.y * 45.0 + time * 14.0);
		float part = step(0.985, H21(floor(float2(q.x * 80.0, q.y * 80.0 + time * 30.0))));
		float glow = exp(-dx / max(w, 0.02)) * 0.6 * step(0.0001, t);
		float white = smoothstep(0.72, 1.0, t);
		float3 col = c2 * (0.7 + 0.3 * rings) + part * 0.8;
		col = lerp(col, c1, white);
		return float4(col, saturate(body * (0.65 + 0.35 * t) + glow * 0.5 + white));
	}
	// A cloven hoof print (two toes + dew claws) in its local frame, size ~0.05; returns a signed distance.
	float HoofPrint(float2 p)
	{
		float2 a = (p - float2(-0.012, -0.01)) / float2(0.010, 0.022);
		float2 b = (p - float2(0.012, -0.01)) / float2(0.010, 0.022);
		float toe = min((length(a) - 1.0) * 0.010, (length(b) - 1.0) * 0.010);
		float dew = min(length(p - float2(-0.016, 0.026)) - 0.005, length(p - float2(0.016, 0.026)) - 0.005);
		return min(toe, dew);
	}
	float4 E28(Texture2D ox, SamplerState os)
	{
		float2 dir = float2(cos(dirRad), sin(dirRad));
		float2 nrm = float2(-dir.y, dir.x);
		float ext = 0.5 * (aspect * abs(dir.x) + abs(dir.y)) + 0.05;
		float d = 9.0; float fill = 9.0;
		float g = saturate((t - 0.55) / 0.45);
		float S = 1.4 * inten;
		for (int i = 0; i < 10; ++i)
		{
			float s = i / 9.0;
			float2 pos = dir * lerp(-ext, ext, s) + nrm * (fmod(i, 2.0) < 0.5 ? 0.06 : -0.06);
			float appear = saturate((t - s * 0.5) / 0.06);
			float sc = appear * (1.0 + 0.25 * sin(appear * 3.14159));
			float2 lp = q - pos;
			lp = float2(dot(lp, nrm), -dot(lp, dir)); // toes point along the walk
			float pd;
			if (useOver > 0.5) { float2 tuv = lp / (0.07 * S * max(sc, 0.001)) + 0.5; pd = (0.5 - Over(ox, os, tuv).a) * 0.02 * step(0.0, tuv.x) * step(tuv.x, 1.0) * step(0.0, tuv.y) * step(tuv.y, 1.0) + 0.02 * (1.0 - step(0.0, tuv.x) * step(tuv.x, 1.0) * step(0.0, tuv.y) * step(tuv.y, 1.0)); }
			else pd = HoofPrint(lp / max(S * sc, 0.001)) * S * sc;
			pd = appear > 0.0 ? pd : 9.0;
			d = min(d, pd);
			fill = min(fill, length(q - pos) - pow(g, 1.3) * MaxR(pos) * 1.05);
		}
		float printA = Fill(d);
		float fillA = Fill(fill) * step(0.0001, g);
		float3 col = lerp(c1, c2, printA * (1.0 - fillA * 0.7));
		return float4(col, saturate(printA + fillA));
	}
	float4 E29(Texture2D sx, SamplerState ss)
	{
		float scan = 0.75 + 0.25 * sin(uv.y * 600.0 / max(inten, 0.2) + time * 20.0);
		float col_h = H11(floor(uv.x * 140.0));
		if (SnapOn() && op < 0.5)
		{
			float jit = (H21(float2(floor(uv.y * 90.0), floor(time * 24.0))) - 0.5) * 0.02 * t;
			float l = Luma(Snap(sx, ss, uv + float2(jit, 0.0)));
			float holo = smoothstep(0.0, 0.35, t);
			float3 col = lerp(Snap(sx, ss, uv), c2 * (0.25 + 1.2 * l) * scan, holo);
			float gone = step(1.0 - uv.y, t * 1.6 - 0.45 - col_h * 0.4);
			float streak = exp(-abs((1.0 - uv.y) - (t * 1.6 - 0.45 - col_h * 0.4)) / 0.02) * step(0.0001, t);
			col = lerp(col, c1, gone) + c2 * streak * 0.8;
			return float4(col, saturate(t * 40.0));
		}
		float front = t * 1.3 - 0.15 - col_h * 0.15;
		float m = op > 0.5 ? 1.0 - uv.y : uv.y;
		float a = Fill((m - front) * 0.5);
		float grid = step(0.94, frac(q.x * 40.0)) + step(0.94, frac(q.y * 40.0));
		float3 col = c1 + c2 * (0.15 * grid + 0.35 * exp(-abs(m - front) / 0.015)) * scan;
		return float4(col, saturate(a + exp(-abs(m - front) / 0.015) * 0.8 * step(0.0001, t) * step(t, 0.9999)));
	}
	float4 E30(Texture2D sx, SamplerState ss)
	{
		float front = t * 1.35 - 0.2;
		float m = op > 0.5 ? 1.0 - uv.y : uv.y;
		float conv = Fill((m - front) * 0.5);
		float frontLine = exp(-abs(m - front) / 0.006) * step(0.0001, t) * step(t, 0.9999);
		float grid = 1.0 - smoothstep(0.0, px * 1.5, min(abs(frac(q.x * 12.0) - 0.5), abs(frac(q.y * 12.0) - 0.5)) / 12.0 - 0.5 / 12.0 + px);
		float fade = smoothstep(0.82, 1.0, t);
		if (SnapOn() && op < 0.5)
		{
			float2 du = float2(1.5 * px / aspect, 0.0); float2 dv = float2(0.0, 1.5 * px);
			float tl = Luma(Snap(sx, ss, uv - du - dv)); float tc = Luma(Snap(sx, ss, uv - dv)); float tr = Luma(Snap(sx, ss, uv + du - dv));
			float ml = Luma(Snap(sx, ss, uv - du)); float mr = Luma(Snap(sx, ss, uv + du));
			float bl = Luma(Snap(sx, ss, uv - du + dv)); float bc = Luma(Snap(sx, ss, uv + dv)); float br = Luma(Snap(sx, ss, uv + du + dv));
			float gx = -tl - 2.0 * ml - bl + tr + 2.0 * mr + br;
			float gy = -tl - 2.0 * tc - tr + bl + 2.0 * bc + br;
			float edge = saturate(length(float2(gx, gy)) * 3.0 * inten);
			float3 wire = c1 + c2 * (edge + 0.08) * (1.0 - fade);
			float3 col = lerp(Snap(sx, ss, uv), wire, conv) + c2 * frontLine;
			return float4(col, saturate(t * 40.0));
		}
		// Procedural: a perspective floor grid (horizon at 45 %) in the converted area.
		float2 g = float2(q.x / max(uv.y - 0.45, 0.02), 1.0 / max(uv.y - 0.45, 0.02));
		float lines = step(0.92, frac(g.x * 2.0)) + step(0.92, frac(g.y * 1.0 + time * 0.5));
		lines *= step(0.45, uv.y);
		float3 col = c1 + c2 * (saturate(lines) * 0.8 + 0.1) * (1.0 - fade) + c2 * frontLine;
		return float4(col, saturate(conv + frontLine));
	}
	float4 E31()
	{
		float rows = max(4.0, round(cnt));
		float s = 1.0 / rows;
		float2 cell = floor(q / s);
		float2 f = frac(q / s);
		float thr = 0.6 * H21(cell) + 0.4 * Along((cell + 0.5) * s, dirRad);
		float lt = saturate((t - thr * 0.8) / 0.2);
		float h = lt;                              // the cube flips up: its height grows
		float inside = step(abs(f.x - 0.5), 0.5) * step(1.0 - h, f.y) * step(0.0001, lt);
		float top = step(f.y, 1.0 - h + 0.28 * h);
		float side = step(0.8, f.x);
		float3 col = c1 * lerp(1.0, 0.55, side);
		col = lerp(col, c2, top * (1.0 - side * 0.5));
		float edge = step(min(min(f.x, 1.0 - f.x), 1.0 - f.y), 0.04);
		col *= 1.0 - edge * 0.35;
		return float4(col, inside);
	}
	float4 E32(Texture2D sx, SamplerState ss)
	{
		float sy = lerp(1.0, 0.004, smoothstep(0.0, 0.5, t));
		float sx2 = lerp(1.0, 0.004, smoothstep(0.5, 0.85, t));
		float dotFade = 1.0 - smoothstep(0.85, 1.0, t);
		float2 hw = float2(aspect * 0.5 * sx2, 0.5 * sy);
		float2 p = q - CenterQ() * 0.0;
		float box = SdBox(p, hw);
		float win = Fill(box);
		float glow = exp(-max(box, 0.0) / 0.01) * smoothstep(0.2, 0.6, t) * dotFade;
		if (SnapOn() && op < 0.5)
		{
			float2 u = QToUV(p / float2(max(sx2, 0.001), max(sy, 0.001)));
			float3 img = lerp(Snap(sx, ss, u), float3(1, 1, 1), smoothstep(0.2, 0.55, t));
			float3 col = lerp(c1, img * dotFade, win) + c2 * glow;
			return float4(col, saturate(t * 40.0));
		}
		// Power on / without a snapshot: the scene is seen through the window, which is white while it is a line.
		float white = smoothstep(0.3, 0.6, t);
		float a = lerp(1.0 - win, 1.0, white * win) * step(0.0001, t);
		a = max(a, saturate(1.0 - win * (1.0 - white)));
		float3 col = lerp(c1, float3(1, 1, 1) * dotFade, win * white) + c2 * glow;
		return float4(col, saturate(a + glow));
	}
	float4 E33()
	{
		float e = (op > 0.5 ? t : EaseOutBack(t)) * 0.5;
		float lx = uv.x - e;               // left panel covers uv.x < e
		float rx = (1.0 - uv.x) - e;       // right panel covers uv.x > 1 - e
		float a = max(Fill(lx * aspect), Fill(rx * aspect));
		float inner = min(abs(lx), abs(rx)) * aspect;   // distance to the inner (leading) edge
		float local = lx < 0.0 ? e - uv.x : uv.x - (1.0 - e);
		float hazard = step(inner, 0.05) * step(0.5, frac((q.x + q.y) * 16.0));
		float seam = 1.0 - smoothstep(0.0, 0.004, abs(frac(local * aspect * 3.0) - 0.5) * 0.33);
		float lamp = exp(-abs(uv.y - 0.5) / 0.01) * step(0.06, inner) * step(inner, 0.12);
		float3 col = c1 * (0.85 + 0.15 * uv.y) * (1.0 - seam * 0.3);
		col = lerp(col, lerp(float3(0.05, 0.05, 0.05), c2, hazard), step(inner, 0.05));
		col += c2 * lamp * 1.5;
		return float4(col, a);
	}
	float4 E34()
	{
		float a = 0.0; float3 col = c1;
		for (int k = 0; k < 4; ++k)
		{
			float fk = k;
			float lt = saturate((t - fk * 0.12) / 0.64);
			lt = 1.0 - pow(1.0 - lt, 3.0);
			float y0 = fk / 4.0;
			float inBand = step(y0, uv.y) * step(uv.y, y0 + 0.25 + 0.001);
			float edge = (op > 0.5 ? 1.0 - uv.x : uv.x) - (1.0 - lt * 1.3) - (uv.y - y0) * 0.25 * aspect * 0.3;
			float ak = Fill(-edge * aspect) * inBand * step(0.0001, lt);
			float3 ck = fmod(fk, 2.0) < 0.5 ? c1 : c2;
			col = lerp(col, ck, ak);
			a = max(a, ak);
		}
		float stripe = step(abs(uv.y - 0.62), 0.012) * step(0.5, t);
		col = lerp(col, float3(1, 1, 1), stripe * 0.8);
		return float4(col, a);
	}
	float4 E35()
	{
		// Five comic panels separated by slanted white gutters.
		float l1 = uv.y - (0.40 + (uv.x - 0.5) * 0.10);
		float l2 = l1 < 0.0 ? uv.x - (0.58 + (uv.y - 0.2) * 0.12) : uv.x - (0.33 - (uv.y - 0.7) * 0.10);
		float l3 = uv.x - (0.70 + (uv.y - 0.7) * 0.10);
		float pid = l1 < 0.0 ? (l2 < 0.0 ? 0.0 : 1.0) : (l2 < 0.0 ? 2.0 : (l3 < 0.0 ? 3.0 : 4.0));
		float gut = min(abs(l1), abs(l2));
		if (l1 > 0.0) gut = min(gut, abs(l3));
		gut *= aspect;
		float gutter = 1.0 - smoothstep(0.004, 0.004 + px, gut);
		float delay = pid * 0.13;
		float lt = saturate((t - delay) / 0.4);
		float2 hp = Rot(q, 0.6) * 90.0;
		float halftone = step(length(frac(hp) - 0.5), 0.5 * saturate(lt * 1.6));
		float ink = smoothstep(0.5, 1.0, lt);
		float panelA = saturate(halftone + ink) * step(0.0001, lt);
		float3 col = lerp(c2, c1, ink);
		float gutA = gutter * smoothstep(0.0, 0.15, t);
		col = lerp(col, float3(1, 1, 1), gutA);
		return float4(col, saturate(panelA + gutA));
	}
	float4 E36(Texture2D sx, SamplerState ss)
	{
		float2 tg = float2(cos(dirRad), sin(dirRad));
		float2 nm = float2(-tg.y, tg.x);
		float2 p = q - CenterQ();
		float s = dot(p, nm);
		float al = dot(p, tg);
		float L = MaxR(CenterQ()) * 1.05;
		float draw = saturate(t / 0.28);
		float lineOn = step(al, lerp(-L, L, draw)) * step(0.0001, t);
		float split = saturate((t - 0.28) / 0.72);
		split = split * split * (3.0 - 2.0 * split);
		float gap = split * L * 1.1;
		float flash = exp(-abs(s) / (0.003 + gap * 0.05)) * lineOn * (1.0 - split * 0.7);
		float inGap = Fill(abs(s) - gap * 0.5);
		if (SnapOn() && op < 0.5)
		{
			float side = s > 0.0 ? 1.0 : -1.0;
			float2 off = nm * side * gap * 0.5 + tg * side * gap * 0.25;
			float3 img = Snap(sx, ss, QToUV(q - off));
			float3 col = lerp(img, c1, inGap) + c2 * flash * 1.5;
			return float4(col, saturate(t * 40.0));
		}
		float3 col = c1 + c2 * flash * 1.5;
		return float4(col, saturate(inGap + flash));
	}
	float4 E37()
	{
		float2 drift = float2(time * 0.12, -time * 0.07);
		float n = Fbm(q * 2.4 + drift) * 0.7 + Fbm(q * 5.0 - drift * 1.7) * 0.3;
		float m = op > 0.5 ? 1.0 - uv.y : uv.y;
		float dens = n * 0.6 + m * 0.4 - (1.0 - t * 1.45);
		float a = smoothstep(0.0, 0.22 + soft * 0.2, dens);
		float3 col = lerp(c2, c1, saturate(n * 1.2));
		return float4(col, a);
	}
	float4 E38(Texture2D sx, SamplerState ss)
	{
		float2 c = CenterQ();
		float2 p = q - c;
		float r = length(p);
		float mr = MaxR(c) * 1.3;
		float R = pow(op > 0.5 ? 1.0 - t : t, 0.8) * mr;
		float w = 0.06;
		float rr = (r - R) / w; float ring = exp(-rr * rr) * step(0.0001, t) * step(t, 0.9999);
		if (SnapOn() && op < 0.5)
		{
			float2 disp = (r > 0.0001 ? p / r : float2(0, 0)) * 0.05 * inten * ring;
			float3 img = Snap(sx, ss, QToUV(q - disp));
			float behind = Fill(r - (R - w * 1.5));
			float3 col = lerp(img, c1, behind * smoothstep(0.0, 0.3, t)) + c2 * ring * 0.6;
			return float4(col, saturate(t * 40.0));
		}
		float cov = op > 0.5 ? Fill(R - r) : Fill(r - R);
		float rc = (r - R - 0.012) / 0.01; float ca = exp(-rc * rc) * step(0.0001, t) * step(t, 0.9999);
		float3 col = c1 + c2 * ring + float3(ca, 0.0, ca * 0.5) * 0.6;
		return float4(col, saturate(cov + ring * 0.9 + ca * 0.5));
	}
	float4 E39(Texture2D sx, SamplerState ss)
	{
		float2 c = CenterQ();
		float mr = MaxR(c);
		float hold = 0.11;
		float R;
		if (op > 0.5) R = t > 0.85 ? 0.0 : (t > 0.55 ? hold : lerp(mr * 1.05, hold, t / 0.55));
		else R = t < 0.8 ? lerp(mr * 1.05, hold, smoothstep(0.0, 0.8, t)) : lerp(hold, 0.0, smoothstep(0.8, 0.97, t));
		float edgeW = 0.06 * (1.0 - smoothstep(0.4, 0.8, t)) + 0.004;
		float r = length(q - c);
		float outside = smoothstep(R - edgeW, R + edgeW * 0.2, r);
		float ringFlash = exp(-abs(r - R) / 0.004) * step(0.5, t) * step(t, 0.97) * 0.8;
		if (SnapOn() && op < 0.5)
		{
			float zoom = 1.0 + 0.6 * smoothstep(0.0, 0.9, t);
			float3 img = Snap(sx, ss, QToUV(c + (q - c) / zoom));
			float3 col = lerp(img, c1, outside) + c2 * ringFlash;
			return float4(col, saturate(t * 40.0));
		}
		return float4(c1 + c2 * ringFlash, saturate(outside + ringFlash));
	}
	float4 E40(Texture2D sx, SamplerState ss)
	{
		float sgn = cos(dirRad) >= 0.0 ? 1.0 : -1.0;
		if (SnapOn() && op < 0.5)
		{
			float off = sgn * t * t * 1.6;
			float L = t * 0.28;
			float3 acc = 0;
			for (int k = 0; k < 12; ++k)
			{
				float2 u = uv + float2(off + sgn * L * (k / 11.0), 0.0);
				u.x = 1.0 - abs(frac(u.x * 0.5) * 2.0 - 1.0); // mirrored repeat keeps the pan continuous
				acc += Snap(sx, ss, u);
			}
			float3 col = acc / 12.0;
			col = lerp(col, c1, smoothstep(0.6, 1.0, t));
			return float4(col, saturate(t * 40.0));
		}
		float row = floor(uv.y * 140.0);
		float hr = H11(row);
		float x = frac(uv.x * (0.5 + hr) - sgn * time * (2.0 + hr * 3.0));
		float streak = smoothstep(0.0, 0.6, x) * (1.0 - step(0.85, x));
		float a = saturate(t * 1.6 - hr * 0.5 + streak * 0.35 * t);
		a = smoothstep(0.0, 1.0, a);
		float3 col = c1 * (0.7 + 0.3 * streak) + c2 * hr * 0.2;
		return float4(col, a);
	}

	// ---------------------------------------------------------------- 41 / 42 spirals
	// One continuous spiral ribbon (one arm, no petals, no sector blades). Its edges are two smooth spiral curves joined
	// by a round tip, so the mask / scene border is one smooth closed curve. Spiral phase u = radial turns + angle / 2pi;
	// the ribbon is f = frac(u) in [0, w). L = how far along the ribbon (in turns) a point lies; the ribbon exists up to
	// its tip S. d < 0 inside the ribbon (signed distance in screen units, for anti-aliasing).
	// The one spiral mask shared by 41 Spiral Close and 42 Spiral Open: the black coverage for coverage k (0 = scene fully
	// visible, 1 = fully black). A spiral wipe: a hand turns around Center (clockwise from 12 o'clock; Reverse =
	// counter-clockwise, Direction = start angle in degrees) and blacks out everything beyond its radius, while that radius
	// shrinks steadily to 0 over Count turns (after a quick iris from the corners to Intensity x half the screen height); one more turn closes the last slit. The visible part
	// is one aperture bounded by a single smooth spiral curve (the radius at each angle is the hand's radius when it last
	// passed), with one step at the hand. Origin 1 (bFromCenter): the black grows from Center outward instead. Close plays
	// k 0 -> 1; Open plays the same k 1 -> 0, so the open is the exact time reverse of the close.
	float SpiralHandR(float h, float N, float R0)
	{
		float a = saturate(h / N);
		return origin > 0.5 ? R0 * a : R0 * (1.0 - a);
	}
	float SpiralCover(float k)
	{
		float2 c = CenterQ();
		float2 p = q - c;
		float r = length(p);
		float mr = MaxR(c) + 2.0 * px;
		// The aperture first closes quickly from the screen corners to a circle of radius R0 (Intensity x half the screen
		// height) during the first 15 %, while the hand starts; then the hand's radius shrinks from R0 to 0.
		float R0 = min(0.5 * clamp(inten, 0.2, 3.0), mr);
		float iris = lerp(mr, R0, smoothstep(0.0, 0.15, k));
		float N = max(cnt, 0.25);                                  // turns until the radius reaches its end
		float H = k * (N + 1.0);                                   // turns the hand has made
		float ang = rev * atan2(p.x, -p.y) - dirRad;               // clockwise from 12 o'clock
		float phi = frac(ang / 6.2831853);                         // this pixel's position on a turn (0..1)
		float behind = frac(H - phi);                              // turns since the hand last passed it
		float last = H - behind;                                   // the hand's turns at that pass (< 0: not reached)
		float d;
		if (origin > 0.5)
		{
			// From Center: the black grows outward (the iris is not used); the last turn sweeps to the corners.
			float dA = last < 0.0 ? 1e4 : r - SpiralHandR(last, N, mr);
			float dB = H <= 0.0 ? 1e4 : max((1.0 - behind) * 6.2831853 * r, r - SpiralHandR(H, N, mr));
			d = min(dA, dB);
		}
		else
		{
			// Signed distance to the black (< 0 inside): beyond the iris, beyond the radius the hand left at its last pass,
			// and the hand's leading edge.
			float dI = iris - r;
			float dA = last < 0.0 ? 1e4 : min(iris, SpiralHandR(last, N, R0)) - r;
			float dB = H <= 0.0 ? 1e4 : max((1.0 - behind) * 6.2831853 * r, min(iris, SpiralHandR(H, N, R0)) - r);
			d = min(dI, min(dA, dB));
		}
		return Fill(d);
	}
	float4 E41() { return float4(c1, SpiralCover(t)); }
	float4 E42() { return float4(c1, SpiralCover(t)); } // same mask as 41; the Open phase plays t backwards

	float4 Run(Texture2D sx, SamplerState ss, Texture2D ox, SamplerState os, float effect)
	{
		int e = (int)round(effect);
		float4 r = float4(c1, t);
		switch (e)
		{
		case 1: r = E01(); break;          case 2: r = E02(); break;          case 3: r = E03(); break;
		case 4: r = E04(sx, ss); break;    case 5: r = E05(); break;          case 6: r = E06(); break;
		case 7: r = E07(); break;          case 8: r = E08(); break;          case 9: r = E09(); break;
		case 10: r = E10(); break;         case 11: r = E11(); break;         case 12: r = E12(sx, ss); break;
		case 13: r = E13(); break;         case 14: r = E14(sx, ss); break;   case 15: r = E15(sx, ss); break;
		case 16: r = E16(sx, ss); break;   case 17: r = E17(); break;         case 18: r = E18(); break;
		case 19: r = E19(); break;         case 20: r = E20(sx, ss); break;   case 21: r = E21(); break;
		case 22: r = E22(); break;         case 23: r = E23(sx, ss); break;   case 24: r = E24(); break;
		case 25: r = E25(ox, os); break;   case 26: r = E26(ox, os); break;   case 27: r = E27(); break;
		case 28: r = E28(ox, os); break;   case 29: r = E29(sx, ss); break;   case 30: r = E30(sx, ss); break;
		case 31: r = E31(); break;         case 32: r = E32(sx, ss); break;   case 33: r = E33(); break;
		case 34: r = E34(); break;         case 35: r = E35(); break;         case 36: r = E36(sx, ss); break;
		case 37: r = E37(); break;         case 38: r = E38(sx, ss); break;   case 39: r = E39(sx, ss); break;
		case 40: r = E40(sx, ss); break;   case 41: r = E41(); break;         case 42: r = E42(); break;
		default: break;
		}
		// Optional art: tints the covered area with the overlay texture (the shape-based effects above use it as
		// their shape instead).
		if (useOver > 0.5 && e != 25 && e != 26 && e != 28)
		{
			float4 o = Over(ox, os, uv);
			r.rgb = lerp(r.rgb, o.rgb, o.a);
		}
		r.a = saturate(r.a);
		if (t <= 0.0001) r.a = 0.0;
		if (t >= 0.9999) r.a = 1.0;
		r.rgb = max(r.rgb, 0.0);
		return r;
	}
};

FACFTransition S;
S.uv = UV;
S.aspect = max(Aspect, 0.01);
S.q = (UV - 0.5) * float2(S.aspect, 1.0);
S.t = saturate(T);
S.op = Opening;
S.inten = Intensity;
S.dirRad = Direction * 0.01745329;
S.seed = Seed;
S.time = Time;
S.soft = Softness;
S.cnt = Count;
S.rev = Reverse < 0.0 ? -1.0 : 1.0;
S.c1 = Col.rgb;
S.c2 = Col2.rgb;
S.ctr = Center.xy;
S.useSnap = UseSnap;
S.useOver = UseOver;
S.px = max(fwidth(S.q.y), 0.0001);
S.origin = Origin;
S.snapEnc = SnapEnc;
return S.Run(SnapTex, SnapTexSampler, OverTex, OverTexSampler, Effect);
